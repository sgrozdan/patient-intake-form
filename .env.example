### APP
VERSION=0.1.0
DOMAIN="test.form.pro4eyes.com"
TRAEFIK_ROUTER=patientIntakeForm
BASE_URL="https://${DOMAIN}"
PORT=8501

# API Configuration
SERVICE_TOKEN=your-service-token
CATALOGUE_URL=http://pro4eyes.com/api/external_catalogues.php
PATIENT_ADD_URL=http://pro4eyes.com/api/external_patient_add.php

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
# SMTP username. Optional: defaults to SENDER_EMAIL.
# Set it when the provider authenticates with a credential id instead of the
# sender address, e.g. Amazon SES:
#   SMTP_SERVER=email-smtp.us-east-1.amazonaws.com
#   SMTP_LOGIN=AKIAIOSFODNN7EXAMPLE
#   SENDER_PASSWORD=<SES SMTP password>
SMTP_LOGIN=
SENDER_EMAIL=your-email@example.com
SENDER_PASSWORD=your-app-password
RECIPIENT_EMAIL=recipient@example.com
